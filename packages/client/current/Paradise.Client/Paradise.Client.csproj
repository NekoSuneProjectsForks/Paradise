<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <OutputPath>..\..\..\..\.release\client\_pak\UberStrike_Data\Managed</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateSupportedRuntime>False</GenerateSupportedRuntime>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <NoWarn>NU1902</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <PropertyGroup>
    <ParadiseVersion>2.2.0.1</ParadiseVersion>
    <ParadiseBuild>4.7.1-$([System.DateTime]::Now.ToString('yyMMdd-HHmm'))</ParadiseBuild>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>none</DebugType>
    <DebugSymbols>False</DebugSymbols>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowedReferenceRelatedFileExtensions>
      <!-- Prevent default XML and PDB files copied to output in RELEASE.
           Only *.allowedextension files will be included, which doesn't exist in my case.
      -->
      .allowedextension
    </AllowedReferenceRelatedFileExtensions>
    <PathMap>
      $([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=C:\buildroot\$(MSBuildProjectName)
    </PathMap>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
  </PropertyGroup>

  <Target Name="AddGeneratedConstantsFile" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <GeneratedText>
<![CDATA[
using System%3B

namespace $(RootNamespace) {
    public static class ParadiseConstants {
        public const string Version = "$(ParadiseVersion)"%3B
        public const string Build = "$(ParadiseBuild)"%3B
    }
}
]]>
      </GeneratedText>
      <GeneratedFilePath>$(IntermediateOutputPath)GeneratedConstantsFile.cs</GeneratedFilePath>
    </PropertyGroup>
    <ItemGroup>
      <Compile Include="$(GeneratedFilePath)" />
      <FileWrites Include="$(GeneratedFilePath)" />
    </ItemGroup>
    <WriteLinesToFile Lines="$(GeneratedText)" File="$(GeneratedFilePath)" WriteOnlyWhenDifferent="false" Overwrite="true" />
  </Target>

  <Target Name="AddGeneratedVersionFile" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <GeneratedText>
$(ParadiseVersion)
$(ParadiseBuild)
        </GeneratedText>
      <GeneratedFilePath>..\..\..\ws\VERSION</GeneratedFilePath>
    </PropertyGroup>
    <ItemGroup>
      <FileWrites Include="$(GeneratedFilePath)" />
    </ItemGroup>
    <WriteLinesToFile Lines="$(GeneratedText)" File="$(GeneratedFilePath)" WriteOnlyWhenDifferent="false" Overwrite="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.2.2" />
    <PackageReference Include="log4net" Version="2.0.17" />
    <PackageReference Include="YamlDotNet" Version="13.7.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\..\assemblies\4.7.1\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>..\..\..\assemblies\4.7.1\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\..\assemblies\4.7.1\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RuntimeUnityExplorer.Core">
      <HintPath>..\..\..\assemblies\RuntimeUnityEditor.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shims\Photon3Unity3D\Photon3Unity3D.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="log4net.config" />
    <EmbeddedResource Include="ScreenResolutions.xml" />
    <EmbeddedResource Include="Resources\icon_console.png" />
    <EmbeddedResource Include="Resources\icon_discord.png" />
    <EmbeddedResource Include="Resources\icon_github.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Paradise.Client.DiscordRPC\IRichPresenceServiceContract.cs">
      <Link>Plugins\RichPresence\IRichPresenceServiceContract.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Paradise.Patch.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>..\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

    <ItemGroup>
    <Content Include="../../../assemblies/System.Runtime.Serialization.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PreBuildEvent>
      taskkill /f /im UberStrike.exe 2&gt;nul 1&gt;nul
exit 0
    </PreBuildEvent>
  </PropertyGroup>
</Project>
