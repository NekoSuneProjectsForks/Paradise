{
  "name": "@festivaldev/paradise-webservices",
  "version": "2.1.2-1",
  "author": "Team FESTIVAL <weare@festival.tf>",
  "description": "Provides SOAP web services and assets for UberStrike",
  "homepage": "https://github.com/festivaldev/paradise-js",
  "license": "GPL-3.0-only",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "start": "bun src/index.ts",
    "build-all": "NODE_ENV=production bun run build-all:dev",
    "build-all:dev": "bun run build:win-x64 && bun run build:linux-x64 && bun run build:darwin-x64 && bun run build:linux-arm64 && bun run build:darwin-arm64",
    "build:win-x64": "bun build ./src/index.ts --compile --minify --target=bun-windows-x64 --outfile=../../.release/server/_pak/Paradise.WebServices/Paradise.WebServices_x64.exe",
    "build:linux-x64": "bun build ./src/index.ts --compile --minify --target=bun-linux-x64 --outfile=../../.release/server/_pak/Paradise.WebServices/paradise-linux-amd64",
    "build:linux-arm64": "bun build ./src/index.ts --compile --minify --target=bun-linux-arm64 --outfile=../../.release/server/_pak/Paradise.WebServices/paradise-linux-arm64",
    "build:darwin-x64": "bun build ./src/index.ts --compile --minify --target=bun-darwin-x64 --outfile=../../.release/server/_pak/Paradise.WebServices/paradise-darwin-amd64",
    "build:darwin-arm64": "bun build ./src/index.ts --compile --minify --target=bun-darwin-arm64 --outfile=../../.release/server/_pak/Paradise.WebServices/paradise-darwin-arm64"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/bcryptjs": "^3",
    "@types/body-parser-xml": "^",
    "@types/bun": "latest",
    "@types/express": "^5",
    "@types/node": "^22",
    "@types/seedrandom": "^3",
    "@types/ws": "^8",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^8",
    "eslint-config-airbnb-base": "^15",
    "eslint-config-prettier": "^9",
    "eslint-plugin-prettier": "^5",
    "pg-hstore": "^2",
    "prettier": "^3",
    "typescript": "~5.5.0",
    "typescript-eslint": "^8"
  },
  "dependencies": {
    "@festivaldev/paradise-models": "workspace:*",
    "@festivaldev/uberstrike-js": "workspace:*",
    "bcryptjs": "^3",
    "body-parser": "^2",
    "body-parser-xml": "^2",
    "chalk": "^4",
    "commander": "^13",
    "discord.js": "^14",
    "express": "^5",
    "http-status": "^2",
    "moment": "^2",
    "morgan": "^1",
    "mysql2": "^3",
    "seedrandom": "^3",
    "sequelize": "^6",
    "winston": "^3",
    "winston-daily-rotate-file": "^5",
    "ws": "^8",
    "yaml": "^2"
  }
}
