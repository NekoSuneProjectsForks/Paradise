{
  "name": "@festivaldev/paradise-webservices",
  "version": "2.2.0",
  "author": "Team FESTIVAL <weare@festival.tf>",
  "description": "Provides SOAP web services and assets for UberStrike",
  "homepage": "https://github.com/festivaldev/paradise",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun src/index.ts",
    "seed": "bun src/index.ts -- seed",
    "dev": "bun --watch src/index.ts",
    "build-all": "NODE_ENV=production bun run build-all:dev",
    "build-all:dev": "bun run build:win-x64 && bun run build:win-arm64 && bun run build:linux-x64 && bun run build:darwin-x64 && bun run build:linux-arm64 && bun run build:darwin-arm64",
    "build:win-x64": "bun build ./src/index.ts --compile --minify --target=bun-windows-x64 --outfile=../../.release/server/_pak/Paradise.WebServices/Paradise.WebServices_x64.exe",
    "build:win-arm64": "bun build ./src/index.ts --compile --minify --target=bun-windows-arm64 --outfile=../../.release/server/_pak/Paradise.WebServices/Paradise.WebServices_arm64.exe",
    "build:linux-x64": "bun build ./src/index.ts --compile --minify --target=bun-linux-x64 --outfile=../../.release/server/_pak/Paradise.WebServices/paradise-linux-x64",
    "build:linux-arm64": "bun build ./src/index.ts --compile --minify --target=bun-linux-arm64 --outfile=../../.release/server/_pak/Paradise.WebServices/paradise-linux-arm64",
    "build:darwin-x64": "bun build ./src/index.ts --compile --minify --target=bun-darwin-x64 --outfile=../../.release/server/_pak/Paradise.WebServices/paradise-darwin-x64",
    "build:darwin-arm64": "bun build ./src/index.ts --compile --minify --target=bun-darwin-arm64 --outfile=../../.release/server/_pak/Paradise.WebServices/paradise-darwin-arm64"
  },
  "devDependencies": {
    "@festivaldev/eslint-config": "catalog:",
    "@festivaldev/prettier-config": "catalog:",
    "@festivaldev/typescript-config": "catalog:",
    "@types/body-parser": "^1",
    "@types/body-parser-xml": "^2",
    "@types/bun": "catalog:",
    "@types/cli-table": "^0.3",
    "@types/express": "^5",
    "@types/morgan": "^1",
    "@types/node": "catalog:",
    "@types/seedrandom": "^3",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@festivaldev/paradise-models": "workspace:*",
    "@festivaldev/uberstrike-js": "workspace:*",
    "@inquirer/prompts": "^8",
    "body-parser": "^2",
    "body-parser-xml": "^2",
    "chalk": "^4",
    "cli-table": "^0.3",
    "commander": "^14",
    "date-fns": "catalog:",
    "discord.js": "^14",
    "express": "^5",
    "http-status": "^2",
    "morgan": "^1",
    "mysql2": "^3",
    "seedrandom": "^3",
    "sql.js": "^1",
    "typeorm": "catalog:",
    "winston": "^3",
    "winston-daily-rotate-file": "^5",
    "winston-loki": "^6",
    "yocto-spinner": "^1"
  }
}
